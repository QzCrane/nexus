dist
build
# The Remote site deploys without a build step: its protocol projection is a
# committed release asset owned by remote-site/README.md, not a build output.
!remote-site/dist/
!remote-site/dist/protocol.js
node_modules
.venv
venv
*.log
*.zip
.aider*
# AI tool session memory is environment state, never repository content.
.workbuddy/
chatgpt-conversation-timeline
reference
.graph-it
.wrangler
.turbo/
.cache/
coverage/
playwright-report/
test-results/
.vscode/
.idea/
release/
artifacts/

# NEXUS skills: only `<repo>/.agents/skills/<name>/SKILL.md` is tracked.
# This is the Anthropic cross-tool standard path (per https://agentskills.io/),
# read natively by Cursor / Codex / Copilot / Gemini CLI / Cline / OpenCode /
# Amp / Kimi / Replit. No mirrors are generated — Antigravity/TRAE users
# maintain their skills in their own global config (`~/.agent/skills/`) instead.

# Halo local public-candidate build output
halo-public-candidate-*/
