{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"root": true,
	"vcs": {
		"enabled": false
	},
	"files": {
		"includes": [
			"**",
			"!**/.cache",
			"!**/.playwright-user-data",
			"!**/dist",
			"!**/node_modules",
			"!**/.turbo",
			"!**/assets-backup",
			"!**/build",
			"!**/coverage",
			"!**/playwright-report",
			"!**/release",
			"!**/test-results",
			"!**/vendor",
			"!**/*.md"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
