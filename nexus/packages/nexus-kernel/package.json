{
	"name": "@nexus/kernel",
	"version": "0.0.1",
	"private": true,
	"description": "NEXUS Core Kernel - Typed RPC Bus & Storage Repository",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./messages": {
			"import": "./dist/messages/index.js",
			"types": "./dist/messages/index.d.ts"
		},
		"./storage": {
			"import": "./dist/storage/index.js",
			"types": "./dist/storage/index.d.ts"
		},
		"./*": null
	},
	"scripts": {
		"build": "bun tsc -b --force",
		"dev": "bun tsc -b --watch",
		"lint": "bun ../../scripts/run-strict-biome.ts .",
		"typecheck": "bun tsc --noEmit -p tsconfig.typecheck.json --tsBuildInfoFile typecheck.tsbuildinfo"
	},
	"dependencies": {
		"@nexus/contracts": "workspace:*"
	},
	"devDependencies": {
		"typescript": "7.0.2",
		"chrome-types": "^0.1.440"
	}
}
