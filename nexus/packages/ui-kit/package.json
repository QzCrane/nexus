{
	"name": "@nexus/ui-kit",
	"version": "0.1.0",
	"private": true,
	"description": "Shared UI components and utilities for NEXUS extensions",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun tsc",
		"dev": "bun tsc --watch",
		"lint": "bun ../../scripts/run-strict-biome.ts .",
		"typecheck": "bun tsc --noEmit -p tsconfig.typecheck.json --tsBuildInfoFile typecheck.tsbuildinfo"
	},
	"dependencies": {
		"@nexus/contracts": "workspace:*"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"devDependencies": {
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"typescript": "^5.3.0"
	}
}
