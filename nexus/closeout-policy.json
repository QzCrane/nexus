{
	"schemaVersion": 1,
	"requiredAttempts": 2,
	"targetBranch": "main",
	"hostedRequired": false,
	"allowedHostedStatuses": [
		"SUCCESS",
		"INFRA_UNAVAILABLE",
		"NOT_APPLICABLE"
	],
	"lanes": [
		{
			"label": "HALO local release",
			"args": ["run", "release:halo"]
		},
		{
			"label": "SPECTRA local release",
			"args": ["run", "release:spectra"]
		}
	],
	"platform": {
		"image": "oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4",
		"environment": {
			"PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
			"PUPPETEER_SKIP_DOWNLOAD": "true"
		},
		"lanes": [
			["install", "--frozen-lockfile"],
			["run", "check:toolchain"],
			["test", "scripts/platform-contract.test.ts"],
			["run", "check:governance"],
			["scripts/generate-tool-registry.ts", "--check"],
			["test", "apps/extension-halo/test/release-tooling.spec.ts", "apps/extension-spectra/test/release-tooling.spec.ts", "scripts/closeout-governance.spec.ts"]
		]
	},
	"products": {
		"halo": {
			"versionFile": "apps/extension-halo/package.json",
			"artifact": "apps/extension-halo/release/.staging/halo-v{version}.zip"
		},
		"spectra": {
			"versionFile": "apps/extension-spectra/package.json",
			"artifact": "apps/extension-spectra/release/spectra-v{version}.zip"
		}
	},
	"toolFiles": [
		"bun.lock",
		"closeout-policy.json",
		"scripts/closeout-evidence.ts",
		"scripts/dependency-audit.ts",
		"scripts/generate-sbom.ts",
		"scripts/runtime-performance.ts",
		"scripts/release-halo.ts",
		"scripts/release-spectra.ts"
	]
}
