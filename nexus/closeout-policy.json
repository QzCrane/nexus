{
	"schemaVersion": 1,
	"requiredAttempts": 2,
	"targetBranch": "main",
	"hostedRequired": false,
	"allowedHostedStatuses": [
		"SUCCESS",
		"INFRA_UNAVAILABLE",
		"NOT_APPLICABLE"
	],
	"lanes": [
		{
			"label": "HALO local release",
			"args": ["run", "release:halo"]
		},
		{
			"label": "SPECTRA local release",
			"args": ["run", "release:spectra"]
		}
	],
	"platform": {
		"image": "oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6",
		"environment": {
			"PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
			"PUPPETEER_SKIP_DOWNLOAD": "true"
		},
		"lanes": [
			["install", "--cwd", "..", "--frozen-lockfile", "--ignore-scripts"],
			["install", "--frozen-lockfile"],
			["run", "check:toolchain"],
			["scripts/check-dependency-domains.ts"],
			["test", "scripts/platform-contract.test.ts"],
			["run", "check:governance"],
			["scripts/generate-tool-registry.ts", "--check"],
			["test", "apps/extension-halo/test/release-tooling.spec.ts", "apps/extension-spectra/test/release-tooling.spec.ts", "scripts/closeout-governance.spec.ts"]
		]
	},
	"products": {
		"halo": {
			"versionFile": "apps/extension-halo/package.json",
			"artifact": "apps/extension-halo/release/.staging/halo-v{version}.zip"
		},
		"spectra": {
			"versionFile": "apps/extension-spectra/package.json",
			"artifact": "apps/extension-spectra/release/spectra-v{version}.zip"
		}
	},
	"toolFiles": [
		"../package.json",
		"../bun.lock",
		"../.github/dependabot.yml",
		"../.github/workflows/dependency-update-evidence.yml",
		"architecture-closure.json",
		"browser-floor.json",
		"bun.lock",
		"closeout-policy.json",
		"dependency-domains.json",
		"dependency-revalidation.json",
		"direct-dependency-policy.json",
		"feature-promotion.json",
		"license-adjudication.json",
		"package.json",
		"runtime-performance-policy.json",
		"source-derived-third-party.json",
		"typescript-7-epoch.json",
		"visual-regression-policy.json",
		"apps/extension-halo/release-admission.json",
		"apps/extension-halo/release-test-owners.json",
		"apps/extension-spectra/permission-policy.json",
		"scripts/artifact-provenance.ts",
		"scripts/capture-retained-dependencies.ts",
		"scripts/check-architecture-closure.ts",
		"scripts/check-dependency-domains.ts",
		"scripts/check-dependency-revalidation.ts",
		"scripts/check-direct-dependencies.ts",
		"scripts/check-feature-promotion.ts",
		"scripts/check-release-test-owners.ts",
		"scripts/check-runtime-performance-policy.ts",
		"scripts/check-source-derived-third-party.ts",
		"scripts/check-spectra-least-privilege.ts",
		"scripts/check-typescript-7-epoch.ts",
		"scripts/check-visual-regression-policy.ts",
		"scripts/closeout-evidence.ts",
		"scripts/toolchain-versions.ts",
		"scripts/check-toolchain.ts",
		"scripts/toolchain-references.ts",
		"scripts/dependency-audit.ts",
		"scripts/dependency-automation.spec.ts",
		"scripts/dependency-update-evidence.ts",
		"scripts/generate-sbom.ts",
		"scripts/product-artifact-snapshot.ts",
		"scripts/release-artifact-provenance.ts",
		"scripts/release-supply-chain.ts",
		"scripts/runtime-performance.ts",
		"scripts/release-halo.ts",
		"scripts/release-spectra.ts"
	]
}
