{
	"name": "@nexus/extension-halo",
	"version": "0.6.0",
	"private": true,
	"description": "HALO - Lightweight Utilities & Dark Mode",
	"type": "module",
	"scripts": {
		"dev": "bun build.ts --watch",
		"build": "bun build.ts --dev",
		"build:prod": "bun build.ts",
		"lint": "bun ../../scripts/run-strict-biome.ts .",
		"typecheck": "bun tsc --noEmit",
		"test": "bun run test:unit",
		"test:unit": "bun test test/exif-reader.spec.ts test/mse-player.spec.ts test/smooth-scroll.spec.ts test/markdown.spec.ts test/stable-ui-identities.spec.ts test/storage-boundaries.spec.ts test/ui-interaction-semantics.spec.ts",
		"test:watch": "bun test --watch test",
		"test:smooth-scroll": "bun test test/smooth-scroll.spec.ts",
		"test:ui": "bun run test:playwright",
		"test:playwright": "bun run build:prod && bunx playwright test test/ui-playwright.spec.ts --workers=1"
	},
	"dependencies": {
		"@nexus/kernel": "workspace:*",
		"@nexus/ui-kit": "workspace:*",
		"@types/qrcode": "^1.5.6",
		"darkreader": "^4.9.118",
		"file-saver": "^2.0.5",
		"jose": "^6.1.3",
		"jsqr": "^1.4.0",
		"jszip": "^3.10.1",
		"pdf-lib": "^1.17.1",
		"pinyin-pro": "^3.27.0",
		"qrcode": "^1.5.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"chrome-types": "^0.1.327",
		"@types/file-saver": "^2.0.7",
		"@types/node": "^20.11.0",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"esbuild": "^0.27.2",
		"playwright": "^1.57.0",
		"puppeteer": "^24.34.0",
		"tsx": "^4.21.0",
		"typescript": "^5.3.0"
	}
}
