{
	"manifest_version": 3,
	"name": "HALO - Ultimate Utility Toolset",
	"version": "0.2.0",
	"description": "Zero upload. Zero tracking. Zero cost. QR generator, color picker, and more.",
	"permissions": [
		"storage",
		"activeTab",
		"scripting",
		"sidePanel",
		"contextMenus"
	],
	"action": {
		"default_title": "Open HALO Toolbox"
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"content.js"
			],
			"run_at": "document_start",
			"all_frames": true
		}
	],
	"icons": {
		"16": "icon16.png",
		"48": "icon48.png",
		"128": "icon128.png"
	}
}