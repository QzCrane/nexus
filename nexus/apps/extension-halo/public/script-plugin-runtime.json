[
  {
    "id": "bilibili-enhancer",
    "pluginType": "script",
    "builtIn": true,
    "script": {
      "type": "javascript",
      "runAt": "document_end",
      "matches": [
        "*://www.bilibili.com/*",
        "*://live.bilibili.com/*"
      ]
    }
  },
  {
    "id": "bilibili-plus",
    "pluginType": "script",
    "builtIn": true,
    "script": {
      "type": "javascript",
      "runAt": "document_start",
      "matches": [
        "*://*.bilibili.com/*"
      ]
    }
  }
]
