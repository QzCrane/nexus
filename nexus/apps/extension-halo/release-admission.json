{
  "schemaVersion": 1,
  "modules": [
    {
      "id": "bilibili-enhancer",
      "stage": "beta",
      "surfaces": ["script-runtime"],
      "activeService": {
        "kind": "saat-registry",
        "owner": "kernel/services/saat-service",
        "readiness": "persisted packaged-script registration reconciled",
        "disposer": "obsolete registered script is unregistered during registry reconciliation"
      },
      "reason": "Explicit beta packaged script."
    },
    {
      "id": "color-picker",
      "stage": "ready",
      "surfaces": ["panel"],
      "reason": "Explicit ready user-facing panel."
    },
    {
      "id": "hover-zoom",
      "stage": "ready",
      "surfaces": ["panel", "content-runtime", "background-runtime"],
      "contentScript": {
        "entry": "src/entry/content-hover-zoom.ts",
        "js": "content-hover-zoom.js",
        "runAt": "document_idle",
        "allFrames": false
      },
      "webAccessibleRuntimes": [
        {
          "entry": "src/entry/content-hover-zoom-runtime.ts",
          "output": "tools/_hover-zoom/runtime.js"
        }
      ],
      "activeService": {
        "kind": "storage-enabled",
        "area": "local",
        "key": "halo_hover_zoom_settings",
        "defaultEnabled": true,
        "owner": "content-hover-zoom",
        "readiness": "storage snapshot hydrated or later change observed",
        "disposer": "settings disable/page retirement disposes the page runtime"
      },
      "reason": "Ready panel plus the shipped lightweight content host and Background DNR reconciliation owner."
    },
    {
      "id": "json-formatter",
      "stage": "ready",
      "surfaces": ["panel"],
      "reason": "Explicit ready user-facing panel."
    },
    {
      "id": "outline",
      "stage": "ready",
      "surfaces": ["panel"],
      "reason": "Explicit ready user-facing panel."
    },
    {
      "id": "qrcode",
      "stage": "ready",
      "surfaces": ["panel", "background-runtime"],
      "reason": "Ready panel and context-menu activation delivery owner."
    },
    {
      "id": "ruler",
      "stage": "ready",
      "surfaces": ["panel", "content-runtime"],
      "contentScript": {
        "entry": "src/entry/content-frame-tools.ts",
        "js": "content-frame-tools.js",
        "runAt": "document_start",
        "allFrames": true
      },
      "webAccessibleRuntimes": [
        {
          "entry": "src/entry/content-frame-tools-runtime.ts",
          "output": "tools/_frame-tools/runtime.js"
        }
      ],
      "reason": "Ready panel and the admitted Ruler-only Frame Tools content-runtime capability."
    },
    {
      "id": "settings",
      "stage": "ready",
      "surfaces": ["panel"],
      "reason": "Core ready settings panel."
    },
    {
      "id": "smooth-scroll",
      "stage": "support",
      "surfaces": ["content-runtime"],
      "contentScript": {
        "entry": "src/entry/content-smooth-scroll.ts",
        "js": "content-smooth-scroll.js",
        "runAt": "document_start",
        "allFrames": false
      },
      "activeService": {
        "kind": "storage-enabled",
        "area": "sync",
        "key": "HALO_SMOOTH_SCROLL_SETTINGS",
        "defaultEnabled": true,
        "owner": "content-smooth-scroll",
        "readiness": "storage snapshot hydrated or later change observed",
        "disposer": "settings disable/page retirement removes input ownership"
      },
      "reason": "Existing shipped document-start runtime retained without implicitly publishing its currently unclassified panel."
    },
    {
      "id": "userscripts",
      "stage": "support",
      "surfaces": ["panel", "background-runtime"],
      "activeService": {
        "kind": "userscripts-authority",
        "owner": "system/userscripts/storage-authority",
        "readiness": "user-script storage authority hydrated",
        "disposer": "subscription disposer retires SidePanel observation"
      },
      "reason": "Runtime and editor support required by admitted packaged/user scripts; support admission is independent from catalog maturity status."
    }
  ]
}
