{
	"name": "@nexus/extension-spectra",
	"version": "1.3.4",
	"private": true,
	"description": "SPECTRA - The Audio & Video Enhancement Extension",
	"type": "module",
	"scripts": {
		"dev": "bun build.mjs --watch --dev",
		"build": "bun build.mjs",
		"build:prod": "bun run build",
		"build:dev": "bun build.mjs --dev",
		"build:sourcemap": "bun build.mjs --sourcemap",
		"build:analyze": "bun build.mjs --analyze",
		"build:copy": "powershell -Command \"Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue; Copy-Item -Recurse public dist\"",
		"lint": "biome check src test public build.mjs scripts --max-diagnostics=100",
		"integrity": "bun scripts/check-production-artifacts.mjs",
		"package": "bun run --cwd ../.. release:spectra",
		"package:dist": "bun scripts/create-release.mjs --stage",
		"package:stage": "bun run package:dist",
		"test:unit": "bun scripts/run-tests.mjs",
		"test": "bun run test:unit && bun run test:chrome",
		"test:smoke": "bun test test/smoke.spec.ts",
		"test:chrome": "bun run build:dev && bun run test:smoke",
		"test:e2e": "bun run test:chrome",
		"test:zip-smoke": "bun scripts/smoke-release.mjs",
		"typecheck": "bun tsc --noEmit"
	},
	"dependencies": {
		"@nexus/audio-engine": "workspace:*",
		"@nexus/kernel": "workspace:*",
		"peerjs": "^1.5.5",
		"uqr": "^0.1.3"
	},
	"devDependencies": {
		"@types/puppeteer": "^7.0.4",
		"chrome-types": "^0.1.327",
		"esbuild": "^0.27.2",
		"puppeteer": "^24.34.0",
		"sharp": "^0.34.5",
		"terser": "5.43.1",
		"tsx": "^4.21.0",
		"typescript": "^5.3.0"
	}
}
