{
	"name": "@nexus/extension-spectra",
	"version": "1.4.2",
	"private": true,
	"description": "SPECTRA - The Audio & Video Enhancement Extension",
	"type": "module",
	"scripts": {
		"dev": "bun build.ts --watch --dev",
		"build": "bun build.ts && bun scripts/check-lean-hotkey-artifact.ts",
		"build:prod": "bun run build",
		"build:dev": "bun build.ts --dev",
		"build:sourcemap": "bun build.ts --sourcemap",
		"build:analyze": "bun build.ts --analyze",
		"check:dist": "bun scripts/check-dist-integrity.ts",
		"generate:remote-projection": "bun scripts/generate-remote-projection.ts",
		"lint": "bun ../../scripts/run-strict-biome.ts .",
		"integrity": "bun scripts/check-production-artifacts.ts",
		"package": "bun run --cwd ../.. release:spectra",
		"package:dist": "bun scripts/create-release.ts --stage",
		"package:stage": "bun run package:dist",
		"test:unit": "bun scripts/run-tests.ts",
		"test:watch": "bun test --watch test",
		"test": "bun run test:unit && bun run test:chrome",
		"test:smoke": "bun test test/smoke",
		"test:smoke:en-US": "bun scripts/run-smoke-locale.ts en-US",
		"test:smoke:zh-CN": "bun scripts/run-smoke-locale.ts zh-CN",
		"test:chrome:dist": "bun scripts/test-chrome-dist.ts",
		"test:chrome": "bun run build:dev && bun run test:smoke",
		"test:e2e": "bun run test:chrome",
		"test:zip-smoke": "bun scripts/smoke-release.ts",
		"typecheck": "bun tsc --noEmit",
		"capture:visual-baseline": "bun scripts/capture-visual-baseline.ts",
		"test:performance": "bun test test/performance.spec.ts && bun test test/popup-inventory-latency.spec.ts && bun test test/runtime-stress-performance.spec.ts && bun test test/service-worker-wake-performance.spec.ts && bun test test/runtime-long-session-performance.spec.ts",
		"test:visual": "bun test test/visual-baseline.spec.ts",
		"test:chrome:dist:fast": "bun run test:smoke"
	},
	"dependencies": {
		"@nexus/audio-engine": "workspace:*",
		"@nexus/kernel": "workspace:*",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@types/qrcode": "^1.5.6",
		"chrome-types": "^0.1.440",
		"esbuild": "^0.28.2",
		"jsqr": "^1.4.0",
		"puppeteer": "25.9.0",
		"puppeteer-floor": "npm:puppeteer-core@24.7.2",
		"sharp": "0.35.4",
		"terser": "5.51.2",
		"typescript": "7.0.2"
	}
}
