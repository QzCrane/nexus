{
	"name": "@nexus/extension-spectra",
	"version": "1.4.2",
	"private": true,
	"description": "SPECTRA - The Audio & Video Enhancement Extension",
	"type": "module",
	"scripts": {
		"dev": "bun build.ts --watch --dev",
		"build": "bun build.ts && bun scripts/check-lean-hotkey-artifact.ts",
		"build:prod": "bun run build",
		"build:dev": "bun build.ts --dev",
		"build:sourcemap": "bun build.ts --sourcemap",
		"build:analyze": "bun build.ts --analyze",
		"lint": "bun ../../scripts/run-strict-biome.ts .",
		"integrity": "bun scripts/check-production-artifacts.ts",
		"package": "bun run --cwd ../.. release:spectra",
		"package:dist": "bun scripts/create-release.ts --stage",
		"package:stage": "bun run package:dist",
		"test:unit": "bun scripts/run-tests.ts",
		"test:watch": "bun test --watch test",
		"test": "bun run test:unit && bun run test:chrome",
		"test:smoke": "bun test test/smoke.spec.ts && bun test test/tab-visibility-chrome.spec.ts && bun test test/diagnostics-chrome.spec.ts",
		"test:performance": "bun test test/performance.spec.ts",
		"test:chrome:dist:fast": "bun run test:smoke",
		"test:chrome:dist": "bun run test:chrome:dist:fast && bun run test:performance",
		"test:chrome": "bun run build:dev && bun run test:chrome:dist",
		"test:e2e": "bun run test:chrome",
		"test:zip-smoke": "bun scripts/smoke-release.ts",
		"typecheck": "bun tsc --noEmit"
	},
	"dependencies": {
		"@nexus/audio-engine": "workspace:*",
		"@nexus/kernel": "workspace:*",
		"peerjs": "^1.5.5",
		"uqr": "^0.1.3"
	},
	"devDependencies": {
		"chrome-types": "^0.1.327",
		"esbuild": "^0.27.2",
		"puppeteer": "25.6.0",
		"sharp": "0.35.3",
		"terser": "5.43.1",
		"tsx": "^4.21.0",
		"typescript": "^5.3.0"
	}
}
