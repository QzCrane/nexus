{
	"name": "nexus",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Project NEXUS - Chrome Extension Ecosystem (SPECTRA, HALO)",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build --output-logs=new-only",
		"build:spectra": "turbo run build --filter=@nexus/extension-spectra... --output-logs=new-only",
		"build:halo": "turbo run build --filter=@nexus/extension-halo... --output-logs=new-only",
		"lint": "bun scripts/run-lint-parallel.ts",
		"lint:workspace-coverage": "bun test scripts/check-workspace-lint.spec.ts scripts/run-strict-biome.spec.ts && bun scripts/check-workspace-lint.ts",
		"lint:repository-surfaces": "bun scripts/run-strict-biome.ts scripts package.json biome.json tsconfig.base.json turbo.json ../package.json ../commitlint.config.cjs ../.codex/hooks.json ../remote-site",
		"lint:ai-pitfalls": "bun scripts/hooks/ai-pitfall-detector.ts",
		"typecheck": "turbo run typecheck",
		"typecheck:spectra": "turbo run typecheck --filter=@nexus/contracts --filter=@nexus/kernel --filter=@nexus/audio-engine --filter=@nexus/extension-spectra",
		"typecheck:halo": "turbo run typecheck --filter=@nexus/contracts --filter=@nexus/kernel --filter=@nexus/ui-kit --filter=@nexus/extension-halo",
		"build:spectra-deps": "turbo run build --filter=@nexus/contracts --filter=@nexus/kernel --filter=@nexus/audio-engine",
		"build:halo-deps": "turbo run build --filter=@nexus/contracts --filter=@nexus/kernel --filter=@nexus/ui-kit",
		"test:spectra": "bun run --cwd apps/extension-spectra test",
		"test:spectra:dist": "bun run --cwd apps/extension-spectra test:unit && bun run --cwd apps/extension-spectra test:chrome:dist",
		"test:halo": "bun run --cwd apps/extension-halo test:unit",
		"test:watch:spectra": "bun --cwd apps/extension-spectra test:watch",
		"test:watch:halo": "bun --cwd apps/extension-halo test:watch",
		"check:toolchain": "bun scripts/check-toolchain.ts",
		"check:platform": "bun test scripts/platform-contract.test.ts && bun scripts/check-platform-contract.ts",
		"check:governance": "bun test scripts/permission-governance.spec.ts scripts/closeout-governance.spec.ts scripts/dependency-audit.spec.ts scripts/verify/check-misc.spec.ts scripts/generate-sbom.spec.ts",
		"audit:dependencies": "bun scripts/dependency-audit.ts",
		"generate:sbom": "bun scripts/generate-sbom.ts",
		"check:public-projections": "bun scripts/check-public-projections.ts",
		"check:spectra-remote-live": "bun scripts/check-spectra-remote-live.ts",
		"release:spectra": "bunx bun@1.3.14 scripts/release-spectra.ts",
		"release:spectra:plan": "bunx bun@1.3.14 scripts/release-spectra.ts --list",
		"release:halo": "bunx bun@1.3.14 scripts/release-halo.ts",
		"release:halo:plan": "bunx bun@1.3.14 scripts/release-halo.ts --list",
		"verify": "bun scripts/verify-architecture.ts",
		"verify:q": "bun scripts/verify-architecture.ts -q",
		"verify:v": "bun scripts/verify-architecture.ts -v",
		"docs:check": "bun scripts/lint-docs.ts --strict",
		"prebuild": "bun scripts/run-prebuild-parallel.ts",
		"sync-spectra": "bun scripts/sync-public.ts spectra",
		"sync-halo": "bun scripts/sync-public.ts halo",
		"generate-registry": "bun scripts/generate-tool-registry.ts",
		"sync:skills": "bun scripts/sync-skills.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"chrome-types": "^0.1.327",
		"graceful-fs": "^4.2.11",
		"sharp": "0.35.3",
		"turbo": "2.10.5",
		"typescript": "^5.3.0"
	},
	"overrides": {
		"basic-ftp": "5.3.1",
		"chrome-types": "^0.1.327",
		"ip-address": "10.3.1",
		"js-yaml": "4.3.1",
		"ws": "8.21.1"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/features/*"
	],
	"engines": {
		"node": ">=18"
	}
}
