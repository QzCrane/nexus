{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		"**/.env.*local"
	],
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				"dist/**"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/biome.json",
				"$TURBO_ROOT$/scripts/run-strict-biome.mjs"
			]
		},
		"test": {
			"outputs": ["coverage/**"]
		},
		"typecheck": {
			"dependsOn": [
				"^typecheck"
			]
		}
	}
}
