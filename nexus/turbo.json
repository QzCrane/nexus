{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		"**/.env.*local"
	],
	"globalPassThroughEnv": [
		"SYNC_PUBLIC_DEST"
	],
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig.base.json"
			],
			"outputs": [
				"dist/**",
				"*.tsbuildinfo"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/biome.json",
				"$TURBO_ROOT$/scripts/run-strict-biome.ts"
			]
		},
		"test": {
			"inputs": [
				"$TURBO_DEFAULT$"
			],
			"outputs": [
				"coverage/**"
			]
		},
		"typecheck": {
			"dependsOn": [
				"^typecheck"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig.base.json"
			],
			"outputs": [
				"**/*.tsbuildinfo"
			]
		}
	}
}
