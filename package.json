{
	"name": "nexus-root",
	"private": true,
	"packageManager": "bun@1.4.0",
	"scripts": {
		"dev": "bun --cwd nexus dev",
		"build": "bun --cwd nexus build",
		"lint": "bun --cwd nexus lint",
		"typecheck": "bun --cwd nexus typecheck",
		"verify": "bun --cwd nexus verify",
		"verify:q": "bun --cwd nexus verify:q",
		"check:platform": "bun --cwd nexus check:platform",
		"check:public-projections": "bun --cwd nexus check:public-projections",
		"docs:check": "bun --cwd nexus docs:check",
		"generate-registry": "bun --cwd nexus generate-registry",
		"sync:skills": "bun --cwd nexus sync:skills",
		"hooks:test": "bun --cwd nexus scripts/hooks/test.ts",
		"test:unit": "bun --cwd nexus/apps/extension-spectra test:unit",
		"test:watch:spectra": "bun --cwd nexus test:watch:spectra",
		"test:watch:halo": "bun --cwd nexus test:watch:halo",
		"postinstall": "bun run sync:skills && bun nexus/scripts/install-repository-hooks.ts",
		"prepare": "bun nexus/scripts/install-repository-hooks.ts"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"lefthook": "^2.1.12"
	},
	"trustedDependencies": []
}
