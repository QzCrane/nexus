{
	"name": "nexus-root",
	"private": true,
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "bun --cwd nexus dev",
		"build": "bun --cwd nexus build",
		"lint": "bun --cwd nexus lint",
		"typecheck": "bun --cwd nexus typecheck",
		"verify": "bun --cwd nexus verify",
		"verify:q": "bun --cwd nexus verify:q",
		"check:platform": "bun --cwd nexus check:platform",
		"docs:check": "bun --cwd nexus docs:check",
		"generate-registry": "bun --cwd nexus generate-registry",
		"sync:skills": "bun --cwd nexus sync:skills",
		"hooks:test": "bun --cwd nexus scripts/hooks/test.mjs",
		"postinstall": "bun run sync:skills && bunx lefthook install",
		"prepare": "bunx lefthook install"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"lefthook": "^2.1.10",
		"lint-staged": "^17.1.0"
	}
}
